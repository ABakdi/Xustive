/target
**/*.rs.bk
.env
# Ignore the model weights, but keep the licence audit that governs them (a direct child, so the
# negation works — it would not under a blanket `/models/`).
/models/*
!/models/LICENSES.md
# Build output. Hand-authored UI source lives in web/public/ and IS committed.
/web/dist/
/web/node_modules/
/eval/reports/
/data/local/
*.log
.DS_Store
tests/fixtures/corpus/*.jsonl
docs/.obsidian/workspace.json
data/tessdata/

# Fetched separately by scripts/fetch-geoip.sh — tens of MB, republished monthly.
data/geoip/
