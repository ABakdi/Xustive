#!/usr/bin/env bash
# Fast checks only. Anything slower than a few seconds gets bypassed with --no-verify, which is
# worse than not having a hook at all. The full suite runs in CI.
set -e
cd "$(git rev-parse --show-toplevel)"
cargo fmt --all -- --check || { echo "run: cargo fmt --all"; exit 1; }
./scripts/lint-telemetry.sh
./scripts/lint-compose.sh
./scripts/lint-responsive.sh
./scripts/lint-docs.sh
