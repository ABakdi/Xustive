# Copy to .env and adjust. Never commit .env — it is gitignored.
#
# Secrets never live in config/*.toml; those are committed. Anything sensitive belongs here in
# development, and in a mounted secrets file in production.

# --- search backend ---
MEILI_URL=http://localhost:7700
# Leave empty in development (MEILI_ENV=development needs no key).
MEILI_KEY=

# --- dev host ports ---
# Override when they clash with another local stack.
XUSTIVE_MEILI_PORT=7700
XUSTIVE_QDRANT_PORT=6333
XUSTIVE_REDIS_PORT=6390
XUSTIVE_PROM_PORT=9090
XUSTIVE_GRAFANA_PORT=3001

# --- logging ---
RUST_LOG=info,xustive_api=debug
XUSTIVE_LOG_JSON=false
