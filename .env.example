# Copy to .env and adjust. Never commit .env — it is gitignored.
#
# Secrets never live in config/*.toml; those are committed. Anything sensitive belongs here in
# development, and in a mounted secrets file in production.

# --- search backend ---
MEILI_URL=http://localhost:7700
# Leave empty in development (MEILI_ENV=development needs no key).
#
# To use scoped keys instead of the master key — which is how production must run — set
# MEILI_MASTER_KEY below, restart the stack, run `xustive-cli keys --show`, and put the
# *search* key here. The master key can delete every index; the API never needs that.
MEILI_KEY=

# Meilisearch master key. Empty means no authentication at all, which is the development
# default and also why `xustive-cli keys` reports that it cannot create anything.
# Must be at least 16 bytes.
MEILI_MASTER_KEY=

# --- dev host ports ---
# Override when they clash with another local stack.
XUSTIVE_MEILI_PORT=7700
XUSTIVE_QDRANT_PORT=6333
XUSTIVE_REDIS_PORT=6390
XUSTIVE_PROM_PORT=9090
XUSTIVE_GRAFANA_PORT=3001

# --- logging ---
RUST_LOG=info,xustive_api=debug
XUSTIVE_LOG_JSON=false

# ==============================================================================================
# Production only — everything below is read by deploy/docker-compose.prod.yml.
# See docs/Operations/Deploying to a VPS.md. `make preflight` checks these before you deploy.
# ==============================================================================================

# --- the name and the certificate ---
# The hostname this box answers on. Caddy gets a certificate for it, so the DNS A/AAAA record
# must already point here or the request to Let's Encrypt fails.
XUSTIVE_DOMAIN=
# Where the certificate authority sends expiry warnings.
XUSTIVE_ACME_EMAIL=

# --- the admin lock ---
# The key the API requires on /api/v1/admin/*. The API REFUSES TO START on a public address
# without it. Generate one: openssl rand -base64 32
XUSTIVE_ADMIN_KEY=
# The console's browser login, in front of that key. Generate the hash:
#   make admin-password            (asks for the password, prints the hash)
XUSTIVE_ADMIN_USER=admin
XUSTIVE_ADMIN_PASSWORD_HASH=

# The dashboards at https://your-domain/grafana — behind the console password above, and behind
# this one. Never leave it as `admin` on a box with a public address.
XUSTIVE_GRAFANA_PASSWORD=

# --- sizing ---
# Defaults suit a 8 vCPU / 16 GB VPS. The one rule that is not a preference: Meilisearch's
# mem_limit (deploy/docker-compose.yml) must stay ABOVE the index's usedDatabaseSize, or
# indexing collapses — PROB-004. Check it with `make index-size`.
XUSTIVE_API_MEM=6g
XUSTIVE_API_CPUS=4.0
XUSTIVE_CRAWLD_MEM=3g
XUSTIVE_CRAWLD_CPUS=3.0
XUSTIVE_WORKER_MEM=2g
XUSTIVE_WORKER_CPUS=2.0

# Build the API without the summariser on a small box (llama.cpp compilation is the slow, hungry
# part of the build). Empty = no summariser; summaries then say they are unavailable.
XUSTIVE_API_FEATURES=summariser

# Where the GGUF model files live on the host, mounted read-only into the API.
XUSTIVE_MODEL_DIR=../models
